
# This is our image base name
REPOSITORY_NAME=rebelthings/rebelespresso-fw-build

# This is the MD5 of the Dockerfile source that was used to build a container.
# It is saved inside the image created as /md5 so we can track changes in the Dockerfile originator
MD5=$( md5sum "$DIR"/Dockerfile | awk '{ print $1 }' )

